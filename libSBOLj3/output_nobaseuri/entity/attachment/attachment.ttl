PREFIX CHEBI: <https://identifiers.org/CHEBI:>
PREFIX EDAM:  <https://identifiers.org/edam:>
PREFIX GO:    <https://identifiers.org/GO:>
PREFIX SBO:   <https://identifiers.org/SBO:>
PREFIX SO:    <https://identifiers.org/SO:>
PREFIX om:    <http://www.ontology-of-units-of-measure.org/resource/om-2/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX sbol:  <http://sbols.org/v3#>

<https://sbolstandard.org/examples/attachment1>
        a                   sbol:Attachment;
        sbol:displayId      "attachment1";
        sbol:format         EDAM:format_2585;
        sbol:hasNamespace   <https://sbolstandard.org/examples>;
        sbol:hash           "aaa";
        sbol:hashAlgorithm  "sha-256";
        sbol:size           "1000";
        sbol:source         <https://sbolstandard.org/attachment1> .

<https://sbolstandard.org/examples/attachment2>
        a                   sbol:Attachment;
        sbol:displayId      "attachment2";
        sbol:format         EDAM:format_2585;
        sbol:hasNamespace   <https://sbolstandard.org/examples>;
        sbol:hash           "aaa";
        sbol:hashAlgorithm  "sha-256";
        sbol:size           "1000";
        sbol:source         <https://sbolstandard.org/attachment2> .

<https://sbolstandard.org/examples/impl1>
        a                   sbol:Implementation;
        sbol:built          <https://sbolstandard.org/examples/TetR_protein>;
        sbol:displayId      "impl1";
        sbol:hasAttachment  <https://sbolstandard.org/examples/attachment1>;
        sbol:hasNamespace   <https://sbolstandard.org/examples> .

<https://sbolstandard.org/examples/TetR_protein>
        a                  sbol:Component;
        sbol:description   "TetR protein";
        sbol:displayId     "TetR_protein";
        sbol:hasNamespace  <https://sbolstandard.org/examples>;
        sbol:name          "TetR";
        sbol:role          GO:0003700;
        sbol:type          SBO:0000252 .
