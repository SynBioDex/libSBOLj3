PREFIX CHEBI: <https://identifiers.org/CHEBI:>
PREFIX EDAM:  <https://identifiers.org/edam:>
PREFIX GO:    <https://identifiers.org/GO:>
PREFIX SBO:   <https://identifiers.org/SBO:>
PREFIX SO:    <https://identifiers.org/SO:>
PREFIX om:    <http://www.ontology-of-units-of-measure.org/resource/om-2/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX sbol:  <http://sbols.org/v3#>

<https://sbolstandard.org/examples/col1>
        a                  sbol:Collection;
        sbol:displayId     "col1";
        sbol:hasNamespace  <https://sbolstandard.org/examples>;
        sbol:member        <https://sbolstandard.org/examples/LacI_protein> , <https://sbolstandard.org/examples/TetR_protein> .

<https://sbolstandard.org/examples/TetR_protein>
        a                  sbol:Component;
        sbol:description   "TetR protein";
        sbol:displayId     "TetR_protein";
        sbol:hasNamespace  <https://sbolstandard.org/examples>;
        sbol:name          "TetR";
        sbol:role          GO:0003700;
        sbol:type          SBO:0000252 .

<https://sbolstandard.org/examples/LacI_protein>
        a                  sbol:Component;
        sbol:description   "LacI protein";
        sbol:displayId     "LacI_protein";
        sbol:hasNamespace  <https://sbolstandard.org/examples>;
        sbol:name          "LacI";
        sbol:role          GO:0003700;
        sbol:type          SBO:0000252 .
