BASE   <https://synbiohub.org/public/igem/>
PREFIX :      <https://synbiohub.org/public/igem/>
PREFIX CHEBI: <https://identifiers.org/CHEBI:>
PREFIX EDAM:  <https://identifiers.org/edam:>
PREFIX GO:    <https://identifiers.org/GO:>
PREFIX SBO:   <https://identifiers.org/SBO:>
PREFIX SO:    <https://identifiers.org/SO:>
PREFIX om:    <http://www.ontology-of-units-of-measure.org/resource/om-2/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX sbol:  <http://sbols.org/v3#>

<BBa_F2620/SubComponent2>
        a                sbol:SubComponent;
        sbol:displayId   "SubComponent2";
        sbol:instanceOf  :TetR .

:TetR_binding  a           sbol:Component;
        sbol:description   "TetR binding domain";
        sbol:displayId     "TetR_binding";
        sbol:hasFeature    <TetR_binding/SubComponent2> , <TetR_binding/SubComponent1>;
        sbol:hasNamespace  <../igem>;
        sbol:name          "TetRbinding";
        sbol:role          GO:0003700;
        sbol:type          SBO:0000252 .

:BBa_F2620  a                sbol:Component;
        sbol:description     "PoPS Receiver";
        sbol:displayId       "BBa_F2620";
        sbol:hasFeature      <BBa_F2620/SubComponent1> , <BBa_F2620/SubComponent2>;
        sbol:hasInteraction  :protein_production3 , <BBa_F2620/Interaction2> , :protein_production;
        sbol:hasNamespace    <../igem>;
        sbol:name            "BBa_F2620";
        sbol:role            SO:0000704;
        sbol:type            SBO:0000251 .

:TetR   a                  sbol:Component;
        sbol:description   "TetR repressor";
        sbol:displayId     "TetR";
        sbol:hasFeature    <TetR/SubComponent2> , <TetR/SubComponent1>;
        sbol:hasNamespace  <../igem>;
        sbol:name          "TetR";
        sbol:role          GO:0003700;
        sbol:type          SBO:0000252 .

:seqAA  a                  sbol:Sequence;
        sbol:displayId     "seqAA";
        sbol:elements      "AT-";
        sbol:encoding      EDAM:format_1208;
        sbol:hasNamespace  <../igem> .

:seqNA  a                  sbol:Sequence;
        sbol:displayId     "seqNA";
        sbol:elements      "ZAtc";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  <../igem> .

:inhibitor_participation
        a                 sbol:Participation;
        sbol:displayId    "inhibitor_participation";
        sbol:participant  <BBa_F2620/SubComponent1>;
        sbol:role         SBO:0000020 .

<TetR_binding/SubComponent1>
        a                sbol:SubComponent;
        sbol:displayId   "SubComponent1";
        sbol:instanceOf  :TetR .

:BBa_R0040_Sequence2  a    sbol:Sequence;
        sbol:description   "BBa_R0040 sequence";
        sbol:displayId     "BBa_R0040_Sequence2";
        sbol:elements      "aaa";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  <../igem>;
        sbol:name          "Sequence2" .

:protein_production  a  sbol:Interaction;
        sbol:displayId  "protein_production";
        sbol:type       SBO:0000589 .

<TetR/SubComponent1>  a  sbol:SubComponent;
        sbol:displayId   "SubComponent1";
        sbol:instanceOf  :TetR_binding .

<BBa_F2620/SubComponent1>
        a                sbol:SubComponent;
        sbol:displayId   "SubComponent1";
        sbol:instanceOf  :TetR .

:BBa_R0040  a               sbol:Component;
        sbol:description    "TetR repressible promoter";
        sbol:displayId      "BBa_R0040";
        sbol:hasAttachment  :attachment1;
        sbol:hasNamespace   <../igem>;
        sbol:hasSequence    :BBa_R0040_Sequence1;
        sbol:name           "pTetR";
        sbol:role           SO:0000167;
        sbol:type           SBO:0000251 .

<TetR_binding/SubComponent2>
        a                sbol:SubComponent;
        sbol:displayId   "SubComponent2";
        sbol:instanceOf  :BBa_F2620 .

:protein_production3  a        sbol:Interaction;
        sbol:displayId         "protein_production3";
        sbol:hasParticipation  :inhibitor_participation3;
        sbol:type              SBO:0000169 .

<BBa_F2620/Interaction2>
        a                      sbol:Interaction;
        sbol:displayId         "Interaction2";
        sbol:hasParticipation  :inhibitor_participation;
        sbol:type              SBO:0000169 .

<TetR/SubComponent2>  a  sbol:SubComponent;
        sbol:displayId   "SubComponent2";
        sbol:instanceOf  :TetR .

:inhibitor_participation3
        a                 sbol:Participation;
        sbol:displayId    "inhibitor_participation3";
        sbol:participant  <BBa_F2620/SubComponent1>;
        sbol:role         SBO:0000020 .

:attachment1  a            sbol:Attachment;
        sbol:displayId     "attachment1";
        sbol:format        EDAM:format_2585;
        sbol:hasNamespace  <../igem>;
        sbol:size          "100";
        sbol:source        <https://sbolstandard.org/attachment1> .

:BBa_R0040_Sequence1  a    sbol:Sequence;
        sbol:description   "BBa_R0040 sequence";
        sbol:displayId     "BBa_R0040_Sequence1";
        sbol:elements      "tccctatcagtgatagagattgacatccctatcagtgatagagatactgagcac";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  <../igem>;
        sbol:name          "Sequence1" .
