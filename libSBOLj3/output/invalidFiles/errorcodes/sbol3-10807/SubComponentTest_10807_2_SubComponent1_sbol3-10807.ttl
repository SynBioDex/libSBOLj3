BASE   <https://sbolstandard.org/examples/>
PREFIX :      <https://sbolstandard.org/examples/>
PREFIX CHEBI: <https://identifiers.org/CHEBI:>
PREFIX EDAM:  <https://identifiers.org/edam:>
PREFIX GO:    <https://identifiers.org/GO:>
PREFIX SBO:   <https://identifiers.org/SBO:>
PREFIX SO:    <https://identifiers.org/SO:>
PREFIX om:    <http://www.ontology-of-units-of-measure.org/resource/om-2/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX sbol:  <http://sbols.org/v3#>

:insert  a                 sbol:Component;
        sbol:displayId     "insert";
        sbol:hasNamespace  </examples>;
        sbol:hasSequence   :insert_Sequence1;
        sbol:role          SO:0000167;
        sbol:type          SBO:0000251 .

:plasmid_Sequence1  a      sbol:Sequence;
        sbol:description   "plasmid sequence";
        sbol:displayId     "plasmid_Sequence1";
        sbol:elements      "";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  </examples>;
        sbol:name          "Sequence1" .

<plasmid/SubComponent1>
        a                 sbol:SubComponent;
        sbol:displayId    "SubComponent1";
        sbol:hasLocation  <plasmid/SubComponent1/Range1>;
        sbol:instanceOf   :insert .

:insert_Sequence1  a       sbol:Sequence;
        sbol:description   "insert sequence";
        sbol:displayId     "insert_Sequence1";
        sbol:elements      "ttgacggctagctcagtcctaggtacagtgctagc";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  </examples>;
        sbol:name          "Sequence1" .

<plasmid/SubComponent1/Range1>
        a                 sbol:Range;
        sbol:displayId    "Range1";
        sbol:end          "214";
        sbol:hasSequence  :plasmid_Sequence1;
        sbol:start        "181" .

:plasmid  a                sbol:Component;
        sbol:displayId     "plasmid";
        sbol:hasFeature    <plasmid/SubComponent1>;
        sbol:hasNamespace  </examples>;
        sbol:hasSequence   :plasmid_Sequence1;
        sbol:role          SO:0000704;
        sbol:type          SBO:0000251 .
