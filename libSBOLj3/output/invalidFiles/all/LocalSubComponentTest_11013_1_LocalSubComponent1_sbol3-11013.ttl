BASE   <https://sbolstandard.org/examples/>
PREFIX :      <https://sbolstandard.org/examples/>
PREFIX CHEBI: <https://identifiers.org/CHEBI:>
PREFIX EDAM:  <https://identifiers.org/edam:>
PREFIX GO:    <https://identifiers.org/GO:>
PREFIX SBO:   <https://identifiers.org/SBO:>
PREFIX SO:    <https://identifiers.org/SO:>
PREFIX om:    <http://www.ontology-of-units-of-measure.org/resource/om-2/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX sbol:  <http://sbols.org/v3#>

:region_Sequence1  a       sbol:Sequence;
        sbol:description   "region sequence";
        sbol:displayId     "region_Sequence1";
        sbol:elements      "taaagttttcactggaattcttgttgaattagatggt";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  </examples>;
        sbol:name          "Sequence1" .

<E0040/LocalSubComponent1/Range2>
        a                 sbol:Range;
        sbol:displayId    "Range2";
        sbol:end          "30";
        sbol:hasSequence  :E0040_Sequence1;
        sbol:start        "20" .

:E0040_Sequence1  a        sbol:Sequence;
        sbol:description   "E0040 sequence";
        sbol:displayId     "E0040_Sequence1";
        sbol:elements      "";
        sbol:encoding      EDAM:format_1207;
        sbol:hasNamespace  </examples>;
        sbol:name          "Sequence1" .

<E0040/LocalSubComponent1/Cut1>
        a                 sbol:Cut;
        sbol:at           "3";
        sbol:displayId    "Cut1";
        sbol:hasSequence  :E0040_Sequence1 .

:region  a                 sbol:Component;
        sbol:description   "region";
        sbol:displayId     "region";
        sbol:hasNamespace  </examples>;
        sbol:hasSequence   :region_Sequence1;
        sbol:name          "region";
        sbol:role          SO:0000804;
        sbol:type          SBO:0000251 .

<E0040/LocalSubComponent1/Range4>
        a                 sbol:Range;
        sbol:displayId    "Range4";
        sbol:end          "61";
        sbol:hasSequence  :E0040_Sequence1;
        sbol:start        "60" .

<E0040/LocalSubComponent1/Cut3>
        a                 sbol:Cut;
        sbol:at           "13";
        sbol:displayId    "Cut3";
        sbol:hasSequence  :E0040_Sequence1 .

<E0040/LocalSubComponent1/Range1>
        a                 sbol:Range;
        sbol:displayId    "Range1";
        sbol:end          "10";
        sbol:hasSequence  :E0040_Sequence1;
        sbol:start        "6" .

:E0040  a                  sbol:Component;
        sbol:displayId     "E0040";
        sbol:hasFeature    <E0040/LocalSubComponent1>;
        sbol:hasNamespace  </examples>;
        sbol:hasSequence   :E0040_Sequence1;
        sbol:name          "E0040";
        sbol:role          SO:0000316;
        sbol:type          SBO:0000251 .

<E0040/LocalSubComponent1/Range3>
        a                 sbol:Range;
        sbol:displayId    "Range3";
        sbol:end          "60";
        sbol:hasSequence  :E0040_Sequence1;
        sbol:start        "40" .

<E0040/LocalSubComponent1>
        a                 sbol:LocalSubComponent;
        sbol:displayId    "LocalSubComponent1";
        sbol:hasLocation  <E0040/LocalSubComponent1/Range1> , <E0040/LocalSubComponent1/Cut1> , <E0040/LocalSubComponent1/Range2> , <E0040/LocalSubComponent1/Range4> , <E0040/LocalSubComponent1/Cut2> , <E0040/LocalSubComponent1/Range3> , <E0040/LocalSubComponent1/Cut3>;
        sbol:orientation  SO:0001030;
        sbol:role         SO:0000139;
        sbol:type         SBO:0000251 .

<E0040/LocalSubComponent1/Cut2>
        a                 sbol:Cut;
        sbol:at           "12";
        sbol:displayId    "Cut2";
        sbol:hasSequence  :E0040_Sequence1 .
