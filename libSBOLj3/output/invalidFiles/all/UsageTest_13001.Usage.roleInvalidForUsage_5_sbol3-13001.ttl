BASE   <https://sbolstandard.org/examples/>
PREFIX :      <https://sbolstandard.org/examples/>
PREFIX CHEBI: <https://identifiers.org/CHEBI:>
PREFIX EDAM:  <https://identifiers.org/edam:>
PREFIX GO:    <https://identifiers.org/GO:>
PREFIX SBO:   <https://identifiers.org/SBO:>
PREFIX SO:    <https://identifiers.org/SO:>
PREFIX om:    <http://www.ontology-of-units-of-measure.org/resource/om-2/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX sbol:  <http://sbols.org/v3#>

:ExpData  a                sbol:ExperimentalData;
        sbol:displayId     "ExpData";
        sbol:hasNamespace  </examples> .

:toggle_switch_optimised
        a                    sbol:Component;
        sbol:description     "Toggle Switch genetic circuit - codon optimised";
        sbol:displayId       "toggle_switch_optimised";
        sbol:hasNamespace    </examples>;
        sbol:name            "Toggle Switch Optimised";
        sbol:type            SBO:0000241;
        prov:wasGeneratedBy  :activity1 .

:iBioSim  a                sbol:TopLevel , prov:Agent;
        sbol:description   "Software tool";
        sbol:displayId     "iBioSim";
        sbol:hasNamespace  </examples>;
        sbol:name          "iBioSim " .

:SBMLtoSBOLconversion
        a                  sbol:TopLevel , prov:Plan;
        sbol:description   "Optimisation protocol to improve the translation of mRNAs.";
        sbol:displayId     "SBMLtoSBOLconversion";
        sbol:hasNamespace  </examples>;
        sbol:name          "Codon Optimisation Protocol" .

:activity1  a                      sbol:TopLevel , prov:Activity;
        sbol:displayId             "activity1";
        sbol:hasNamespace          </examples>;
        sbol:name                  "activity 1";
        sbol:type                  sbol:design;
        prov:qualifiedAssociation  <activity1/Association1>;
        prov:qualifiedUsage        <activity1/Usage1> .

:model1  a                 sbol:Model;
        sbol:displayId     "model1";
        sbol:framework     SBO:0000062;
        sbol:hasNamespace  </examples>;
        sbol:language      EDAM:format_2585;
        sbol:source        <http://virtualparts.org> .

<activity1/Association1>
        a               sbol:Identified , prov:Association;
        sbol:displayId  "Association1";
        prov:agent      :iBioSim;
        prov:hadPlan    :SBMLtoSBOLconversion;
        prov:hadRole    sbol:design .

:implementation  a         sbol:Implementation;
        sbol:displayId     "implementation";
        sbol:hasNamespace  </examples> .

<activity1/Usage1>  a   sbol:Identified , prov:Usage;
        sbol:displayId  "Usage1";
        prov:entity     :implementation;
        prov:hadRole    sbol:design .
